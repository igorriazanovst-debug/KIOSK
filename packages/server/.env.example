PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/kiosk.db
MEDIA_PATH=./data/media
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# Мастер-секрет для сброса пароля «Хронолинии» (Хронолайнер_план_реализации.md,
# Фаза 4). НИКОГДА не попадает в дистрибутив плеера - только производный
# секрет конкретной сборки (см. packages/server/src/utils/masterCode.js).
# Без этой переменной сборки с виджетом «Хронолиния» просто не получат
# возможность мастер-кода (сборка не падает, см. builds.js).
CHRONO_MASTER_SECRET=change-me-to-a-long-random-value-in-production
